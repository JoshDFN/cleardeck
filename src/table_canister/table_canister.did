type ActionRecord = record {
  action : PlayerAction;
  seat : nat8;
  timestamp : nat64;
};
type LastAction = variant {
  Fold;
  Check;
  Call : record { amount : nat64 };
  Bet : record { amount : nat64 };
  Raise : record { amount : nat64 };
  AllIn : record { amount : nat64 };
  PostBlind : record { amount : nat64 };
};
type LastActionInfo = record {
  seat : nat8;
  action : LastAction;
  timestamp : nat64;
};
type ActionTimer = record {
  player_seat : nat8;
  using_time_bank : bool;
  expires_at : nat64;
  started_at : nat64;
};
type Card = record { rank : Rank; suit : Suit };
type GamePhase = variant {
  Flop;
  Turn;
  River;
  Showdown;
  HandComplete;
  WaitingForPlayers;
  PreFlop;
};
type ShowdownPlayer = record {
  seat : nat8;
  "principal" : principal;
  cards : opt record { Card; Card };
  hand_rank : opt HandRank;
  amount_won : nat64;
};
type HandHistory = record {
  hand_number : nat64;
  actions : vec ActionRecord;
  community_cards : vec Card;
  shuffle_proof : ShuffleProof;
  winners : vec Winner;
  showdown_players : vec ShowdownPlayer;
};
type HandRank = variant {
  StraightFlush : nat8;
  Straight : nat8;
  Pair : record { nat8; blob };
  FullHouse : record { nat8; nat8 };
  TwoPair : record { nat8; nat8; nat8 };
  HighCard : blob;
  ThreeOfAKind : record { nat8; blob };
  Flush : blob;
  RoyalFlush;
  FourOfAKind : record { nat8; nat8 };
};
type Player = record {
  status : PlayerStatus;
  timeout_count : nat8;
  "principal" : principal;
  is_sitting_out_next_hand : bool;
  has_folded : bool;
  chips : nat64;
  seat : nat8;
  hole_cards : opt record { Card; Card };
  total_bet_this_hand : nat64;
  current_bet : nat64;
  has_acted_this_round : bool;
  time_bank_remaining : nat64;
  broke_at : opt nat64;
  last_seen : nat64;
  is_all_in : bool;
};
type PlayerAction = variant {
  Bet : nat64;
  Call;
  Fold;
  Raise : nat64;
  AllIn;
  Check;
};
type PlayerStatus = variant { SittingOut; Active; Disconnected };
type PlayerView = record {
  status : PlayerStatus;
  is_self : bool;
  "principal" : principal;
  has_folded : bool;
  chips : nat64;
  seat : nat8;
  hole_cards : opt record { Card; Card };
  current_bet : nat64;
  is_all_in : bool;
  display_name : opt text;
};
type Rank = variant {
  Ace;
  Six;
  Ten;
  Two;
  Eight;
  Seven;
  Five;
  Four;
  Jack;
  King;
  Nine;
  Three;
  Queen;
};
// --- The commitment check -------------------------------------------------
// A RECORD, not two positional strings. Candid keys record fields by hashed
// name, so `check_shuffle_commitment` cannot be called "backwards": there is no
// argument order to get wrong. This replaced `verify_shuffle`, which took two
// unnamed 64-character hex strings and returned a bare bool, so a transposed
// call and a broken proof were the same answer (docs/DEFECTS.md E-44).
type CommitmentCheckArgs = record {
  // 64 lowercase hex chars: the hand's committed SHA-256.
  seed_hash : text;
  // hex: the seed revealed when the hand ended. 32 bytes in a live hand.
  revealed_seed : text;
};
type CommitmentMatch = record {
  committed_hash : text;
  revealed_seed : text;
  // SHA256(revealed_seed), recomputed. Equal to committed_hash.
  computed_hash : text;
  // Read these two. The canister confirming its own hash is close to
  // meaningless, and these fields say so in the answer itself.
  this_proves : text;
  this_does_not_prove : text;
};
type CommitmentNoMatch = record {
  seed_hash_field : text;
  revealed_seed_field : text;
  // Both readings are shown, so the caller can see BOTH were tried.
  computed_from_revealed_seed : text;
  computed_from_seed_hash : text;
  meaning : text;
};
type CommitmentMalformed = record {
  // "seed_hash" or "revealed_seed": the field at fault, by name.
  field : text;
  reason : text;
  character_length : nat64;
};
type CommitmentCheck = variant {
  // SHA256(revealed_seed) == seed_hash.
  Match : CommitmentMatch;
  // A VALID pair, with the two values in each other's fields. Not a failure.
  FieldsSwapped : CommitmentMatch;
  // Neither reading matches. The only arm that is evidence of a bad proof.
  NoMatch : CommitmentNoMatch;
  // The call could not be evaluated. Names which field and why.
  Malformed : CommitmentMalformed;
};
// --- Durability of the fairness record ------------------------------------
type FairnessRetention = record {
  table_keeps_last_n_hands : nat64;
  table_copy_is_destructible_by_controller : bool;
  archive_canister : opt principal;
  summary : text;
};
type HistoryStatus = record {
  // null means NOTHING IS BEING ARCHIVED off this table.
  history_canister : opt principal;
  recorded_ok_since_start : nat64;
  failed_since_start : nat64;
  in_flight : nat64;
  unrecorded_backlog : nat64;
  unrecorded_dropped : nat64;
  last_recorded_hand : opt nat64;
  last_error : opt text;
  local_history_cap : nat64;
  local_history_len : nat64;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat64; Err : text };
// docs/SECURITY-FINDINGS.md FINDING 29: one line per unfinished ledger operation
// that resolve_my_ledger_intents() drove, saying what the ledger said about it.
type Result_IntentReport = variant { Ok : vec text; Err : text };
type Result_IntentLine = variant { Ok : text; Err : text };
// Why a hand is not moving, and whether anybody can end it.
// docs/SECURITY-FINDINGS.md FINDING 15.
type StuckHandStatus = record {
  is_stuck : bool;
  hand_in_progress : bool;
  // A LOWER BOUND: the hand cannot become abandonable before this. Null when it
  // already is, or when no hand is live. docs/DEFECTS.md E-59 -- abandonment
  // needs the canister to have WATCHED the hand fail to move, not merely for a
  // wall-clock interval to have elapsed, so nothing can promise the exact
  // instant. "Not before" is a sentence a client can show.
  abandonable_in_ns : opt nat64;
  refundable_pot : nat64;
};
// Everything this canister is holding for ONE caller, including the part that is
// not in their withdrawable balance. get_balance() answers only "what can I
// withdraw right now", which is why an auditor read 0 while 2.98 ICP of theirs
// was in a pot. docs/SECURITY-FINDINGS.md FINDING 18.
type CustodyStatus = record {
  // Withdrawable now: the same figure get_balance() returns.
  escrow : nat64;
  // Chips in front of you at the table.
  chips_at_table : nat64;
  // Your own money in the current hand's pot, INCLUDING the stake of a seat you
  // have already left.
  committed_in_pot : nat64;
  // True when that hand can no longer be moved by any message: this canister has
  // watched the ordinary resolution path fail on it across a full grace period.
  committed_is_stuck : bool;
  // A LOWER BOUND on when it becomes abandonable; null when it already is or
  // when nothing of yours is committed. See StuckHandStatus above.
  abandonable_in_ns : opt nat64;
  // YOUR MONEY AT THE DEPOSIT ADDRESS THIS CANISTER PUBLISHED TO YOU, as of
  // unswept_deposit_observed_at_ns. Held by this canister, in a ledger account
  // only this canister can move, and not withdrawable until
  // claim_external_deposit() sweeps it into `escrow`.
  // docs/SECURITY-FINDINGS.md FINDING 28.
  unswept_deposit : nat64;
  // When the ledger was last asked about that address. NULL MEANS NEVER ASKED,
  // which is not the same as "the address is empty". Call
  // refresh_deposit_custody() to take a reading.
  unswept_deposit_observed_at_ns : opt nat64;
  // MONEY OF YOURS THIS CANISTER HAS MOVED ON THE LEDGER AND NOT YET FINISHED
  // BOOKING, because the ledger call it made did not come back.
  // docs/SECURITY-FINDINGS.md FINDING 29. The fourth place your money can be, and
  // the only one no surface could see before the ledger-intent journal existed:
  // an interrupted deposit looked exactly like a deposit that never happened.
  // resolve_my_ledger_intents() finishes them.
  unfinished_ledger_ops : nat64;
  // escrow + chips_at_table + committed_in_pot + unswept_deposit +
  // unfinished_ledger_ops: everything this canister holds that belongs to you,
  // across every account it owns and every movement it has begun.
  total : nat64;
  // What to do next, in words, naming abandon_stuck_hand when it is needed.
  advice : text;
};
// ONE IRREVERSIBLE LEDGER MOVEMENT THIS CANISTER COMMITTED TO, written down
// BEFORE it was attempted. docs/SECURITY-FINDINGS.md FINDING 29.
//
// An IC message is atomic only up to each await, so a deposit or a withdrawal
// that moves money and then credits the books in its reply callback loses the
// credit -- and not the movement -- if that callback never runs. An entry here is
// how the canister knows whose that money is and how much of it there is, and
// resolve_my_ledger_intents() is how it gets finished. An empty list is the
// normal state.
type LedgerIntentView = record {
  id : nat64;
  who : principal;
  // "pull" (icrc2_transfer_from from your wallet), "sweep" (your deposit
  // subaccount into the main account) or "payout" (the main account to you).
  kind : text;
  amount : nat64;
  opened_at_ns : nat64;
  // How many times the identical ledger transaction has been issued. Retrying is
  // safe: it carries a memo and a created_at_time, so the LEDGER deduplicates it.
  attempts : nat32;
  // Somebody is driving this entry until then; null means nobody is. A lease
  // expires, so a caller that disappeared cannot hold the money hostage.
  leased_until_ns : opt nat64;
  // After this instant a retry would be a SECOND movement, because the ledger no
  // longer deduplicates. The canister refuses to retry past it and keeps the
  // record instead.
  retry_deadline_ns : nat64;
};
// What this canister is holding for one principal at the deposit address it
// published to them. docs/SECURITY-FINDINGS.md FINDING 28, FINDING 11.
type DepositAddressCustody = record {
  // The subaccount half of the address: (this canister, subaccount).
  subaccount : vec nat8;
  // The ledger `observed_amount` was read from.
  ledger : principal;
  // What the ledger reported at observed_at_ns. Zero WITH observed_at_ns = null
  // means nobody has looked, not "there is nothing".
  observed_amount : nat64;
  observed_at_ns : opt nat64;
  // The ledger's transfer fee. At or below it, nothing can move the balance on
  // its own -- top the SAME address up past the fee and the whole balance sweeps.
  transfer_fee : nat64;
  // True when claim_external_deposit() would sweep this amount right now.
  sweepable : bool;
  // The plain-language answer, including the dust case. Never empty when
  // observed_amount > 0.
  note : text;
};
type Result_DepositCustody = variant { Ok : DepositAddressCustody; Err : text };
// (total observed, per-principal (amount, observed_at_ns), addresses NEVER READ).
type Result_DepositCensus = variant {
  Ok : record { nat64; vec record { principal; nat64; nat64 }; vec principal };
  Err : text;
};
// (accounts read this call, total observed, accounts still never read).
type Result_DepositAudit = variant {
  Ok : record { nat64; nat64; nat64 };
  Err : text;
};
// How long this canister can keep answering update calls, and whether its
// on-chain clock is running. docs/SECURITY-FINDINGS.md FINDING 19.
type CycleStatus = record {
  balance : nat;
  // What can actually be SPENT: balance minus the freezing reserve. THIS is the
  // number that reaches zero when deposit/withdraw/cash_out start being rejected.
  liquid_balance : nat;
  reserved_for_freezing : nat;
  // Measured on this instance, not taken from a price list.
  observed_burn_per_day : nat;
  // null means the measurement window is too short to say, which is NOT the same
  // as "plenty".
  runway_days : opt nat64;
  sample_window_secs : nat64;
  measurement_is_meaningful : bool;
  // Ticks the on-chain clock has run since this instance started. Zero on a
  // canister that has been up for minutes means the clock is NOT running.
  clock_ticks : nat64;
  clock_last_tick_at : nat64;
  clock_watchdog_armed : bool;
  next_wake_at : opt nat64;
};
type Result_2 = variant { Ok : TableState; Err : text };
type Result_3 = variant { Ok : record { Card; Card }; Err : text };
type Result_4 = variant { Ok : ShuffleProof; Err : text };
type Result_5 = variant { Ok : TableConfig; Err : text };
type ShuffleProof = record {
  timestamp : nat64;
  seed_hash : text;
  revealed_seed : opt text;
};
type SidePot = record { eligible_players : blob; amount : nat64 };
type Suit = variant { Diamonds; Hearts; Clubs; Spades };
type Currency = variant { ICP; BTC };
type TableConfig = record {
  small_blind : nat64;
  time_bank_secs : nat64;
  action_timeout_secs : nat64;
  ante : nat64;
  min_buy_in : nat64;
  max_players : nat8;
  big_blind : nat64;
  max_buy_in : nat64;
  currency : Currency;
};
type TableState = record {
  id : nat64;
  pot : nat64;
  min_raise : nat64;
  bb_has_option : bool;
  action_on : nat8;
  action_timer : opt ActionTimer;
  dealer_seat : nat8;
  hand_number : nat64;
  deck : vec Card;
  big_blind_seat : nat8;
  auto_deal_at : opt nat64;
  players : vec opt Player;
  current_bet : nat64;
  last_aggressor : opt nat8;
  deck_index : nat64;
  community_cards : vec Card;
  small_blind_seat : nat8;
  first_hand : bool;
  phase : GamePhase;
  config : TableConfig;
  side_pots : vec SidePot;
  shuffle_proof : opt ShuffleProof;
};
type TableView = record {
  id : nat64;
  pot : nat64;
  min_raise : nat64;
  time_bank_remaining_secs : opt nat64;
  action_on : nat8;
  call_amount : nat64;
  my_seat : opt nat8;
  dealer_seat : nat8;
  hand_number : nat64;
  min_bet : nat64;
  big_blind_seat : nat8;
  can_check : bool;
  last_hand_winners : vec Winner;
  time_remaining_secs : opt nat64;
  players : vec opt PlayerView;
  current_bet : nat64;
  community_cards : vec Card;
  small_blind_seat : nat8;
  using_time_bank : bool;
  phase : GamePhase;
  config : TableConfig;
  side_pots : vec SidePot;
  shuffle_proof : opt ShuffleProof;
  is_my_turn : bool;
  can_raise : bool;
  last_action : opt LastActionInfo;
  // THE CALLER's own money in this pot: their seat's stake plus any stake
  // recorded for a seat of theirs already vacated in this hand. Non-zero with
  // `my_seat = null` means money of yours is in a hand you are no longer sitting
  // in. docs/SECURITY-FINDINGS.md FINDING 18.
  my_committed_in_pot : nat64;
  // True when no message can move this hand, so nobody can win the pot and
  // abandon_stuck_hand refunds every stake on request.
  hand_is_unmovable : bool;
};
type TimeoutCheckResult = variant {
  AutoDealReady;
  PlayerTimedOut : nat8;
  NoAction;
};
type Winner = record {
  "principal" : principal;
  hand_rank : opt HandRank;
  cards : opt record { Card; Card };
  seat : nat8;
  amount : nat64;
};
// ckBTC minter types for BTC deposits
type UtxoStatus = variant {
  ValueTooSmall : Utxo;
  Tainted : Utxo;
  Checked : Utxo;
  Minted : record { block_index : nat64; minted_amount : nat64; utxo : Utxo };
};
type Utxo = record {
  outpoint : UtxoOutpoint;
  value : nat64;
  height : nat32;
};
type UtxoOutpoint = record {
  txid : vec nat8;
  vout : nat32;
};
service : (TableConfig) -> {
  // Add a controller (controller only)
  add_controller : (principal) -> (Result);
  // Admin: RECOVERY. Return every chip at the table to the escrow of the player
  // who owns it, ABANDONING any hand in progress, and then rebuild the table with
  // this configuration. Controller only.
  //
  // NOT a config-only call, and no longer a destructive one. Until 2026-08-05 this
  // was byte-identical to reset_table and its comment here read "for recovery after
  // upgrade issues": it replaced the table wholesale, so every seated player's chips
  // ceased to exist -- not returned to escrow, not withdrawable, not recoverable by
  // anybody including you. Measured live: 40.00000000 ICP destroyed by one call.
  // It now returns the money first and refuses outright if any of the pot cannot be
  // attributed to an owner. See docs/SECURITY-FINDINGS.md FINDING 07.
  //
  // If you only want to change the configuration, use reset_table (empty table) or
  // admin_update_config (live table, between hands). Use this one when you need the
  // table structure itself rebuilt and you accept that the hand in progress ends.
  admin_reinit_table : (TableConfig) -> (Result);
  // Admin: RECOVERY, non-destructive. Return every chip at the table -- seated
  // stacks and every stake in the live hand -- to the ESCROW of the player who owns
  // it, and abandon the hand. Returns the total moved, in e8s/sats.
  // Controller only. Conserving: it cannot create or destroy a single unit, it does
  // not touch the ledger, and escrow only ever goes up. Refuses, changing nothing,
  // if state.pot and the attributed stakes disagree (call abandon_stuck_hand first).
  // This is the recovery step FINDING 07 needed and did not have.
  admin_return_all_chips_to_escrow : () -> (Result_1);
  // Admin: a specific player's WITHDRAWABLE ESCROW (controller only, read-only).
  // SCOPE: BALANCES and nothing else. It excludes their chips, their stake in a
  // live pot, and their money at the deposit address this canister published to
  // them (admin_get_deposit_custody). Zero here is not "this canister holds
  // nothing for this player". docs/SECURITY-FINDINGS.md FINDING 28.
  admin_get_balance : (principal) -> (Result_1) query;
  // REMOVED: admin_restore_balance - unnecessary attack surface. It could MINT
  // escrow from nothing. admin_return_all_chips_to_escrow is not a replacement for
  // it and is not the same shape: it only MOVES money the table already holds.
  // Admin: every WITHDRAWABLE ESCROW balance (controller only, read-only).
  // Returns (total_assigned, list of (principal, balance)).
  // SCOPE: one of this canister's ledger accounts, not all of them. The tuple
  // shape cannot grow an element without breaking every existing reader, so the
  // deposit-subaccount half lives at admin_get_deposit_custody. An audit that
  // reads only this method is the audit FINDING 21 walked past: it returned a
  // clean zero on a canister holding 5 ICP at its own published addresses.
  admin_get_all_balances : () -> (variant { Ok : record { nat64; vec record { principal; nat64 } }; Err : text }) query;
  // Admin: Get total chips at table (seated players)
  admin_get_table_chips : () -> (Result_1) query;
  // Admin: Update table configuration (controller only, not during a hand).
  // Refuses a change to `currency` while this canister still owes anybody
  // anything: currency selects the LEDGER withdrawals are paid from, so changing
  // it under funded balances makes every one of them unpayable.
  // See docs/SECURITY-FINDINGS.md FINDING 20.
  admin_update_config : (TableConfig) -> (Result_5);
  // Buy into the table using your escrow balance
  buy_in : (nat8, nat64) -> (Result);
  // Cash out and leave the table
  cash_out : () -> (Result_1);
  // Check for timeouts, auto-fold, and auto-deal
  // This should be called periodically or before each action
  check_timeouts : () -> (TimeoutCheckResult);
  // Deposit ICP to your escrow balance using ICRC-2 transfer_from
  // You must first approve this canister to spend your ICP via icrc2_approve
  deposit : (nat64) -> (Result_1);
  // Claim funds sent to your unique deposit subaccount by an external wallet
  // External wallets transfer to (canister_id, get_deposit_subaccount()), then call this to claim
  claim_external_deposit : () -> (Result_1);
  // Get your unique deposit subaccount for external wallet transfers.
  // A QUERY, so calling it leaves no record: this canister cannot know it
  // published an address to you until you call refresh_deposit_custody() or
  // claim_external_deposit() at least once. See "THE ENUMERABILITY LIMIT" in
  // src/table_canister/src/lib.rs.
  get_deposit_subaccount : () -> (vec nat8) query;
  // FINISH EVERY LEDGER OPERATION THIS CANISTER STARTED FOR YOU AND DID NOT
  // FINISH BOOKING. docs/SECURITY-FINDINGS.md FINDING 29.
  //
  // Safe to call at any time, by anybody, for their own entries. It re-issues the
  // IDENTICAL ledger transaction; the ledger either performs it or answers
  // Duplicate, and either answer settles your balance exactly once. Returns one
  // line per entry.
  resolve_my_ledger_intents : () -> (Result_IntentReport);
  // The same for one entry, by id. Owner or controller.
  resolve_ledger_intent : (nat64) -> (Result_IntentLine);
  // Every unfinished ledger operation of YOURS. Empty is the normal state.
  get_my_ledger_intents : () -> (vec LedgerIntentView) query;
  // The whole journal for a controller; your own entries for anybody else.
  get_all_ledger_intents : () -> (vec LedgerIntentView) query;
  // What this canister LAST SAW at your deposit address, and what to do about it.
  // A query, so it reports the last observation with its timestamp; it cannot
  // call the ledger. docs/SECURITY-FINDINGS.md FINDING 28.
  get_deposit_custody : () -> (DepositAddressCustody) query;
  // Ask the ledger what is at YOUR deposit address right now, write the answer
  // into this canister's books, and return it. Any principal, their own address
  // only, moves no money. This is the call that makes every other surface true.
  refresh_deposit_custody : () -> (Result_DepositCustody);
  // Controller: the deposit-subaccount half of custody, which admin_get_balance
  // and admin_get_all_balances structurally cannot report. The third element is
  // the list of published addresses that have NEVER BEEN READ -- their balances
  // are unknown, not zero. docs/SECURITY-FINDINGS.md FINDING 21.
  admin_get_deposit_custody : () -> (Result_DepositCensus) query;
  // Controller: read every deposit subaccount this canister can enumerate, plus
  // any principal named in the argument, and write down what the ledger says.
  // Moves no money. Required before a currency change: the guard refuses while
  // any published address has never been read.
  admin_audit_deposit_custody : (vec principal) -> (Result_DepositAudit);
  // DEV ONLY: Get free test chips for local development
  // Disabled when dev_mode is false (production)
  dev_faucet : (nat64) -> (Result_1);
  // Check if a player voluntarily showed their cards this hand
  did_player_show : (nat8) -> (bool) query;
  get_action_timer : () -> (opt ActionTimer) query;
  // Your WITHDRAWABLE escrow balance, and nothing else: it excludes the chips in
  // front of you, any stake of yours still in a live pot including a pot you have
  // already left, AND any money sitting at the deposit address this canister
  // published to you. Call get_custody_status for the whole answer.
  // docs/SECURITY-FINDINGS.md FINDING 18, FINDING 28.
  get_balance : () -> (nat64) query;
  get_community_cards : () -> (vec Card) query;
  // Get all controllers
  get_controllers : () -> (vec principal) query;
  // Get the canister's account for deposits
  get_deposit_address : () -> (text) query;
  get_hand_history : (nat64) -> (opt HandHistory) query;
  // Get the history canister ID
  get_history_canister : () -> (opt principal) query;
  // Get max players (for lobby display)
  get_max_players : () -> (nat8) query;
  get_my_cards : () -> (opt record { Card; Card }) query;
  // Get current player count (for lobby display)
  get_player_count : () -> (nat8) query;
  get_pot : () -> (nat64) query;
  // Get cards for a player who voluntarily showed them
  get_shown_cards : (nat8) -> (opt record { Card; Card }) query;
  get_shuffle_proof : () -> (opt ShuffleProof) query;
  // Get the raw table state (admin/debug use - exposes all data)
  // RESTRICTED: Only controllers can access this to prevent cheating
  get_table_state : () -> (Result_2) query;
  // Get the table view from the caller's perspective
  // This properly hides opponent hole cards unless at showdown
  get_table_view : () -> (opt TableView) query;
  get_time_remaining : () -> (opt nat64) query;
  // Player heartbeat to show they're connected
  heartbeat : () -> (Result);
  // Check if dev mode is enabled (always returns false now)
  is_dev_mode : () -> (bool) query;
  // Join table with minimum buy-in from escrow balance
  // Requires sufficient ICP deposited first via notify_deposit
  join_table : (nat8) -> (Result);
  // Leave table and return chips to escrow balance
  // If mid-hand, this acts as a fold - pot contributions stay in the pot
  leave_table : () -> (Result_1);
  // Verify and credit a deposit by checking the ledger transaction
  // Players should first transfer ICP to the canister's account, then call this with the block index
  notify_deposit : (nat64) -> (Result_1);
  player_action : (PlayerAction) -> (Result);
  // Reload chips from escrow (for players already seated who need more chips)
  // Can only be done between hands, not during active play
  reload : (nat64) -> (Result_1);
  // Remove a controller (controller only)
  remove_controller : (principal) -> (Result);
  // Reset the table CONFIGURATION (controller only).
  //
  // REFUSES while any player has chips at the table or there is money in the pot,
  // and tells you to call admin_return_all_chips_to_escrow (or admin_reinit_table)
  // instead. It does NOT require escrow to be empty: escrow is a separate ledger
  // this call provably never writes.
  //
  // Until 2026-08-05 the comment here read "CAUTION: destroys all state". It
  // destroyed MONEY, not state: one call deleted every seated chip permanently.
  // See docs/SECURITY-FINDINGS.md FINDING 07.
  reset_table : (TableConfig) -> (Result);
  // Set dev mode (controller only)
  set_dev_mode : (bool) -> (Result);
  // Set the history canister ID (controller only)
  // Pass None to clear/disable history recording
  set_history_canister : (opt principal) -> (Result);
  // Is the fairness record for this table reaching a durable archive?
  // Public, unauthenticated, and sometimes the honest answer is "no".
  get_history_status : () -> (HistoryStatus) query;
  // How long a proof survives, and who can destroy it. Read this before you sit.
  get_fairness_retention : () -> (FairnessRetention) query;
  // Re-send every settled hand the archive has not acknowledged. Callable by
  // any non-anonymous principal on purpose: the party with the strongest
  // interest in the proof surviving is the player, not the operator.
  // Returns how many records this call sent.
  flush_unrecorded_hands : () -> (Result_1);
  // Voluntarily show your hole cards to the table
  // Only allowed after you've folded or at the end of the hand
  show_cards : () -> (Result_3);
  // Sit back in
  sit_in : () -> (Result);
  // Sit out (voluntarily)
  sit_out : () -> (Result);
  // Request to sit out at the end of the current hand
  sit_out_next_hand : () -> (Result);
  start_new_hand : () -> (Result_4);
  // Use time bank to extend action time
  // Returns remaining time bank seconds
  use_time_bank : () -> (Result_1);
  // Check a commit-reveal pair and say WHICH check failed. Arguments are a
  // record, so there is no order to get wrong; the answer names the fault and
  // carries both hashes. Use this one.
  check_shuffle_commitment : (CommitmentCheckArgs) -> (CommitmentCheck) query;
  // DEPRECATED, kept so an existing caller is not handed a false accusation.
  // Now answers the same question in EITHER argument order, so `false` can no
  // longer mean "you called it backwards". It still cannot tell a malformed
  // argument from a broken proof; `check_shuffle_commitment` can.
  verify_shuffle : (text, text) -> (bool) query;
  // Withdraw your balance from the table.
  // Refuses while you are in a hand THAT CAN STILL PROGRESS. Once the hand is
  // stuck (see get_stuck_hand_status) it does not refuse: a withdrawal pays out
  // of escrow and cannot touch the pot.
  withdraw : (nat64) -> (Result_1);
  // Is this table holding a hand that no message can move, and can it be ended?
  // A query, so it answers even when every update on the settlement path fails.
  get_stuck_hand_status : () -> (StuckHandStatus) query;
  // Everything the canister is holding for YOU, including money in a pot that
  // get_balance cannot report. A client that shows a balance should call this.
  // docs/SECURITY-FINDINGS.md FINDING 18.
  get_custody_status : () -> (CustodyStatus) query;
  // The cycles runway, and whether the on-chain clock is alive. Open to anybody,
  // including anonymous callers: a canister below its freezing threshold rejects
  // EVERY update call -- deposit, withdraw, cash_out, abandon_stuck_hand -- which
  // is a total custody failure with no attacker, so the number that predicts it
  // must not be privileged. There is deliberately no top-up method here yet; see
  // docs/SECURITY-FINDINGS.md FINDING 19 for what one would need.
  get_cycle_status : () -> (CycleStatus) query;
  // End a hand that no message can move and give every stake back to the player
  // who put it in. Anybody may call it; it refuses unless the hand's action clock
  // has been expired for 5 minutes, or the hand has no clock at all. Nobody wins:
  // the only outcome it can produce is "everyone gets their own money back", so
  // there is nothing to gain by forcing it.
  // docs/SECURITY-FINDINGS.md FINDING 15.
  abandon_stuck_hand : () -> (Result_1);
  // Get a BTC deposit address for native Bitcoin deposits
  // Users can send real BTC to this address, then call update_btc_balance
  // Only available for BTC tables
  get_btc_deposit_address : () -> (variant { Ok : text; Err : text });
  // Update BTC balance after sending Bitcoin to the deposit address
  // Checks for new UTXOs and mints ckBTC if confirmed
  // Only available for BTC tables
  update_btc_balance : () -> (variant { Ok : vec UtxoStatus; Err : text });
  // Set a custom display name (visible to all players)
  // Name must be 1-12 characters, alphanumeric with some symbols allowed
  // Pass null to clear the name
  set_display_name : (opt text) -> (Result);
  // Get a player's display name
  get_display_name : (principal) -> (opt text) query;
}
