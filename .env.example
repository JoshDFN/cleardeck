# ClearDeck Environment Variables
# Copy this file to .env and fill in values. icp-cli does NOT auto-generate this
# file (dfx used to) — set the canister IDs manually for production builds.

# Beta Access Password Hash (SHA-256)
# Generate with: echo -n "yourpassword" | shasum -a 256 | cut -d' ' -f1
# Leave empty to disable password protection.
VITE_BETA_PASSWORD_HASH=''

# Canister IDs the frontend bundle needs at build time.
# Only LOBBY + HISTORY are required — every table ID is fetched from the lobby at
# runtime. The deploy scripts export these from .icp/data/mappings/ic.ids.json,
# so you normally don't need to set them by hand for a scripted deploy.
# VITE_CANISTER_ID_LOBBY='kpfcd-kyaaa-aaaaj-qor3a-cai'
# VITE_CANISTER_ID_HISTORY='kggj7-4qaaa-aaaaj-qor2q-cai'

# Optional overrides (default: id.ai/authorize + icp-api.io). See src/lib/ic-config.js.
# VITE_II_URL='https://id.ai/authorize'
# VITE_IC_HOST='https://icp-api.io'
